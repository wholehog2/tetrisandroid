<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde automatique Android (Google) et transfert d'un téléphone à l'autre : Android 12 et plus. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="tetris.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="tetris.xml" />
    </device-transfer>
</data-extraction-rules>
